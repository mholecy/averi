<?xml version="1.0" encoding="utf-8"?>
<!-- The Android lab app (docs/plans/2026-10-15-ground-truth-lab-app.md): one cell of fixtures/apps/cells.json per
     launch, chosen by the string intent extra `cell` (scripts/truth/capture-android.ts starts it with `am start`) or
     the deep link averilab://cell/<id>. averilab://shared/… (L7, D55) and averilab://pair/… (D55c) each resolve to two
     components and open no cell.
     No login, no network, no data. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="AveriLab"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="averilab" android:host="cell" />
            </intent-filter>
            <!-- L7 (D55): averilab://shared/… has two handlers, this activity and the alias below, so the system's
                 resolver (a chooser) answers it; averilab://cell/… keeps one. The app opens no cell for it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="averilab" android:host="shared" />
            </intent-filter>
            <!-- D55c: averilab://pair/… has the same two handlers, for a fresh chooser: "Just once" on `shared`'s left a
                 last-chosen entry the lab AVD keeps (the lab plan's device fact 5), so its chooser is no longer the
                 fresh layout. The app opens no cell for it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="averilab" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- The second handler of averilab://shared/… (D55) and averilab://pair/… (D55c): another component, the same
             activity. -->
        <activity-alias
            android:name=".Twin"
            android:label="AveriLab twin"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="averilab" android:host="shared" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="averilab" android:host="pair" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
