{
  "family": "forms",
  "note": "The form cells (phase 1b): form-keyboard-floating (round 4, Android only) is form-keyboard captured with Gboard floating (`ime`: its panel over the fields, the inset only the 132-px strip — calibration.json #1); fields, errors, the keyboard, prefilled values, the picker sheet; a design-system component sharing one identifier across every field and its floating title (form-shared-id, FE2); the app's model is the oracle (#2, #16, the field-error notes). App files: AveriLab/Forms.swift, Forms.kt (Android, phase 2b: the IME drawn over the form, which keeps its height; only the pinned submit bar rides above it). A pinned submit reports its bar as `<submit>.bar` (truth.ts#situationOf).",
  "cells": [
    {
      "id": "form-basic",
      "layer": "none",
      "targets": [],
      "form": {
        "title": "New payment",
        "fields": [
          { "tag": "name", "kind": "text", "title": "Recipient’s name & surname", "placeholder": "e.g. Jan Šťastný" },
          { "tag": "email", "kind": "email", "title": "E-mail for “receipts”", "placeholder": "jan@example.com" },
          { "tag": "iban", "kind": "iban", "title": "IBAN – account number", "placeholder": "SK00 0000 0000 …" },
          { "tag": "amount", "kind": "amount", "title": "Amount in EUR (max 10 000)", "placeholder": "0,00" },
          { "tag": "pin", "kind": "pin", "title": "PIN…", "placeholder": "4 digits" }
        ],
        "submit": { "tag": "submit", "title": "Send payment" }
      }
    },
    {
      "id": "form-errors",
      "layer": "none",
      "targets": [],
      "form": {
        "title": "New payment",
        "fields": [
          { "tag": "name", "kind": "text", "title": "Recipient’s name & surname", "placeholder": "e.g. Jan Šťastný", "titleId": "lab.form-errors.name", "error": { "text": "Enter the recipient’s name", "id": "lab.form-errors.name" } },
          { "tag": "email", "kind": "email", "title": "E-mail for “receipts”", "placeholder": "jan@example.com", "error": { "text": "That’s not an e-mail – check the “@”", "id": "lab.form-errors.email_error" } },
          { "tag": "amount", "kind": "amount", "title": "Amount in EUR (max 10 000)", "placeholder": "0,00", "error": { "text": "Amount must be 0,01 – 10 000 €", "id": "lab.form-errors.amount" } },
          { "tag": "pin", "kind": "pin", "title": "PIN…", "placeholder": "4 digits", "error": { "text": "PIN must have 4 digits…", "id": "lab.form-errors.pin-error" } },
          { "tag": "iban", "kind": "iban", "title": "IBAN – account number", "placeholder": "SK00 0000 0000 …", "error": { "text": "IBAN “SK00…” isn’t valid", "id": "IbanError" } }
        ],
        "submit": { "tag": "submit", "title": "Send payment" },
        "screenError": { "text": "Payment wasn’t sent — fix the fields & try again", "id": "lab.form-errors.banner_error" },
        "submitOnAppear": true
      }
    },
    {
      "id": "form-keyboard",
      "layer": "none",
      "targets": [],
      "form": {
        "title": "Transfer details",
        "fields": [
          { "tag": "reference", "kind": "text", "title": "Payment reference" },
          { "tag": "message", "kind": "text", "title": "Message for the recipient" },
          { "tag": "street", "kind": "text", "title": "Street & number" },
          { "tag": "city", "kind": "text", "title": "City / town" },
          { "tag": "postcode", "kind": "text", "title": "Postcode" },
          { "tag": "phone", "kind": "text", "title": "Phone – optional" },
          { "tag": "vs", "kind": "text", "title": "Variable symbol" },
          { "tag": "ks", "kind": "text", "title": "Constant symbol" },
          { "tag": "ss", "kind": "text", "title": "Specific symbol" },
          { "tag": "note", "kind": "text", "title": "Note “for me”" }
        ],
        "submit": { "tag": "submit", "title": "Continue", "pinned": true },
        "focus": "postcode"
      }
    },
    {
      "id": "form-keyboard-floating",
